# Supabase Configuration
# Get these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"

# Supabase Service Role Key (server-side only -- bypasses RLS)
# Required for: scripts/seedSpots.ts
# Get from: Supabase Dashboard -> Project Settings -> API -> service_role key
# WARNING: Never expose this in client-side code or commit to git
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database Configuration (legacy -- will be removed after Supabase migration)
# For local development with Docker Compose:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ev_trainer?schema=public"

# For production, use a managed PostgreSQL service URL:
# DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"
