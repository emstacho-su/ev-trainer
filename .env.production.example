# EV Trainer Production Environment Variables
# Copy this file to .env and fill in the values

# Node environment
NODE_ENV=production
PORT=4000

# Database connection (RDS PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Get from Terraform output: terraform output database_url
DATABASE_URL="postgresql://postgres:PASSWORD@RDS_ENDPOINT:5432/ev_trainer?schema=public"

# CORS allowed origins (comma-separated)
# Update with your actual production domain(s)
ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# Optional: Rate limiting (requests per minute per IP)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=100
